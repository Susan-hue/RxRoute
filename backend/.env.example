# ===========================================================================
# RxRoute — copy to .env and fill in. The server refuses to boot without the
# required values; there is no mock fallback to degrade into.
# ===========================================================================

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed by `npm run db:push` / `npm run db:seed`, which run DDL over a
# direct Postgres connection. Project Settings → Database → Connection string.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Twilio (required) -----------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Sandbox number, or your own approved WhatsApp sender
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Google Gemini (required) ----------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# --- Routing behaviour -----------------------------------------------------
SEARCH_RADIUS_METERS=5000
MAX_PHARMACIES_PER_BROADCAST=5
REQUEST_EXPIRY_MINUTES=30
# Only pharmacies the request was actually broadcast to may claim it.
CLAIM_REQUIRES_BROADCAST=true
MAX_MEDIA_BYTES=8388608

# --- Webhook hardening -----------------------------------------------------
# Your public URL (ngrok or deployed). Required when validating signatures,
# since Twilio signs the exact URL it posted to.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
VALIDATE_TWILIO_SIGNATURE=false

# Ack Twilio immediately, then run AI + broadcast in the background.
# Twilio times out at 15s; Gemini plus five sends can exceed that.
# Set false to process inline when testing with curl.
WEBHOOK_ASYNC=true

# --- REST API auth ---------------------------------------------------------
# Guards /api/*. Optional in development, MANDATORY in production — these
# endpoints expose patient phone numbers and prescription contents.
# API_KEY=generate-a-long-random-string

# --- Public web app (/api/public/*) ----------------------------------------
# Browser origins allowed to call the public API, comma-separated. Leave unset
# in development (the Vite dev server proxies /api). Set it when the frontend
# is deployed on its own domain.
# CORS_ORIGINS=https://rxroute.example.com
# Uploads allowed per IP per hour (each one costs a Gemini call).
PUBLIC_UPLOADS_PER_HOUR=20
