{
  "name": "rxroute",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp-native prescription routing and pharmacy locator (Express + Supabase/PostGIS + Twilio + Gemini 2.5 Flash)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:push": "node scripts/applySql.js db/schema.sql",
    "db:seed": "node scripts/applySql.js db/seed.sql",
    "db:verify": "node scripts/verifyDb.js"
  },
  "dependencies": {
    "@google/genai": "^1.12.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "twilio": "^5.3.5",
    "zod": "^3.23.8"
  }
}
